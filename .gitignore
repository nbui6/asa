# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Round 39 cp0 - dist\skills\*.zip is regenerated by kit\sync-skills.ps1
# from kit\skills\, purely for uploading to a Claude account by hand.
# Binary, derived, no diff value - never committed, same reasoning as
# /build/ above.
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Claude Code: the hooks are versioned on purpose - they are the machine check.
# Local state and machine-specific settings are not.
.claude/hooks/.last-pass
**/settings.local.json

# Asa's own settings live in the Windows app-data folder, never here.
# Belt and braces in case that ever changes: a path on disk is machine-specific
# and a username is not something a shared repository needs.
asa_settings.json
*.local.json

# Asa's write log (ADR 0007 guardrail 3) lives in %APPDATA%\Asa\ too, next to
# settings.json — same reasoning, same belt-and-braces entry.
write-log.jsonl

# install-skills.ps1's own manifest and version stamp bake in the exact local
# path the kit was installed from (found 2026-09-13, pushing after Round 24:
# check-shareable.ps1 missed .kit-manifest.json because its path is
# JSON-escaped, C:\\Users\\..., which its pattern does not match — a real gap
# in the checker, not a reason to trust it here). Same reasoning as settings
# above: this is local install state, regenerated fresh by anyone who runs
# the installer on their own machine, not something a shared repository
# needs to carry.
.claude/.kit-manifest.json
.claude/skills/.kit-version

# check-shareable.ps1 derives its private terms and keeps no list. Nothing to ignore.
